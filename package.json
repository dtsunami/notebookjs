{
  "name": "notebookjs",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "labjs": "./bin/notebookjs.js",
    "notebookjs": "./bin/notebookjs.js"
  },
  "scripts": {
    "cli": "node bin/notebookjs.js",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "node scripts/build-cm.mjs && vite build",
    "build:cm": "node scripts/build-cm.mjs",
    "preview": "vite preview",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@lezer/highlight": "^1.2.5",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@uiw/react-codemirror": "^4.23.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "playwright": "^1.64.1",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
